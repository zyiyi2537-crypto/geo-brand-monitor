POSTGRES_DB=geo_monitor
POSTGRES_USER=geo
POSTGRES_PASSWORD=change-this-password
SECRET_KEY=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost

# API-first providers. Leave blank when a provider should stay disabled.
# These are model-provider credentials. GEO Monitor reads them on the server;
# it does not generate them. Create each key in that provider's own console,
# set it here, restart the backend, then use the test connection action.
KIMI_API_KEY=
QWEN_API_KEY=
ZHIPU_API_KEY=
PERPLEXITY_API_KEY=
ARK_API_KEY=
DOUBAO_BOT_ID=

# Optional browser fallback. Do not expose browser-worker directly to the internet.
BROWSER_REGION=cn
BROWSER_ENGINE_LIST=deepseek,doubao,qwen,wenxin,yuanbao
BROWSER_MAX_CONCURRENT=2
BROWSER_GLOBAL_ENGINE_LIST=chatgpt,claude,gemini,grok,copilot
BROWSER_GLOBAL_MAX_CONCURRENT=2
UNIFIED_MAX_CONCURRENT=4

