# Copy to .env.monitor. Keep real values out of Git.
MONITOR_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
MONITOR_ADMIN_TOKEN=replace-with-a-different-random-admin-token
MONITOR_PORT=8080
GEO_AI_BASE_URL=https://api.example.com/v1
GEO_AI_MODEL=replace-with-your-model
GEO_AI_API_KEY=replace-with-your-api-key
GEO_AI_WIRE_API=chat
MONITOR_MAX_QUESTIONS=50
MONITOR_JOB_TIMEOUT=330
# Optional parent-site quota bridge; billing remains owned by the parent site.
MONITOR_QUOTA_URL=
MONITOR_QUOTA_TOKEN=
MONITOR_QUOTA_FAIL_MODE=deny
