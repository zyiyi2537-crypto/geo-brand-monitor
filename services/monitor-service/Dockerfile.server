# Server image for the embeddable GEO monitor module.
# Build context is the repo root so the shared monitoring pipeline is included.
FROM python:3.12-slim
WORKDIR /srv
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 MONITOR_DATA_DIR=/srv/data MONITOR_REPORTS_DIR=/srv/reports
COPY services/monitor-service/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY tools ./tools
COPY services/telemetry-service/app/brand_mentions.py ./services/telemetry-service/app/brand_mentions.py
COPY services/telemetry-service/app/qualified_report.py ./services/telemetry-service/app/qualified_report.py
COPY services/telemetry-service/app/__init__.py ./services/telemetry-service/app/__init__.py
COPY services/monitor-service/monitor_service ./monitor_service
COPY services/monitor-service/static ./static
RUN mkdir -p /srv/data /srv/reports
EXPOSE 8080
CMD ["uvicorn", "monitor_service.main:app", "--host", "0.0.0.0", "--port", "8080"]
